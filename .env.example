# ==========================================
# ASPEO Admin - Environment Variables
# ==========================================
# Copy this file to .env.local and fill in all REQUIRED values
# Variables marked [REQUIRED] will cause build failure if missing

# ------------------------------------------
# DATABASE (REQUIRED)
# ------------------------------------------
# Vercel Postgres or any PostgreSQL database
DATABASE_URL=                           # [REQUIRED] Connection string for Prisma
DATABASE_URL_UNPOOLED=                  # Direct connection (for migrations)

# ------------------------------------------
# AUTHENTICATION (REQUIRED)
# ------------------------------------------
# BetterAuth configuration
BETTER_AUTH_SECRET=                     # [REQUIRED] Min 32 chars. Generate: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3000   # Base URL for auth callbacks

# ------------------------------------------
# EMAIL (REQUIRED)
# ------------------------------------------
# OVH SMTP for security emails (2FA, password reset, etc.)
OVH_EMAIL_USER=                         # [REQUIRED] OVH email address
OVH_EMAIL_PASS=                         # [REQUIRED] OVH email password
RECEIVER_EMAIL=                         # Contact form recipient

# ------------------------------------------
# RATE LIMITING (REQUIRED)
# ------------------------------------------
# Upstash Redis for rate limiting
UPSTASH_REDIS_REST_URL=                 # [REQUIRED] Upstash Redis REST URL
UPSTASH_REDIS_REST_TOKEN=               # [REQUIRED] Upstash Redis REST token

# Vercel KV (alternative, mapped to same values)
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_URL=
REDIS_URL=

# ------------------------------------------
# VERCEL BLOB (REQUIRED for image uploads)
# ------------------------------------------
# Storage for service images
BLOB_READ_WRITE_TOKEN=                  # [REQUIRED] Vercel Blob token from dashboard

# ------------------------------------------
# PUBLIC URL (REQUIRED)
# ------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000  # [REQUIRED] Public URL used in emails/links

# ------------------------------------------
# CRON JOBS (REQUIRED for Vercel)
# ------------------------------------------
# Security token for scheduled cleanup jobs (GDPR compliance)
CRON_SECRET=                            # [REQUIRED] Generate: openssl rand -hex 32

# ------------------------------------------
# ANALYTICS (Optional)
# ------------------------------------------
NEXT_PUBLIC_HOTJAR_ID=
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=

# ==========================================
# SEED SCRIPT VARIABLES (for db:seed)
# ==========================================
# These are NOT required for build, only for seeding
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=YourSecurePassword123!
